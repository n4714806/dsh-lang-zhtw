{
  "name": "dsh-lang-zhtw",
  "version": "1.0.1-patch.3.input.1",
  "type": "module",
  "license": "MIT",
  "description": "繁體中文（台灣）語言包：涵蓋 DSH 內建介面及 Mnemon、Context 外掛的已驗證語系字典；不修改歷史內容。",
  "scripts": {
    "build": "node tools/build-plugin.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "language-pack",
    "zh-TW",
    "traditional-chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n4714806/dsh-lang-zhtw.git"
  },
  "author": "Grasseed",
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "opencc-js": "1.3.1",
    "playwright-core": "1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
